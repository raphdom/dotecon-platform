{
  "name": "dotecon-platform",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter './apps/*' build",
    "dev": "pnpm --filter './apps/*' dev",
    "lint": "pnpm --filter './apps/*' --filter './packages/*' lint",
    "type-check": "pnpm --filter './apps/*' --filter './packages/*' type-check",
    "test": "pnpm --filter './apps/*' --filter './packages/*' test",
    "db:generate": "pnpm --filter @dotecon/db generate",
    "db:migrate": "pnpm --filter @dotecon/db migrate:dev",
    "db:push": "pnpm --filter @dotecon/db push"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
